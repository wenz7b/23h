# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y6 [get_cells u_clk_wiz_1/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y4 [get_cells u_clk_wiz_1/inst/clkout3_buf]
set_property LOC BUFGCTRL_X0Y1 [get_cells u_clk_wiz_1/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y2 [get_cells u_clk_wiz_1/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y5 [get_cells u_clk_wiz_0/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells u_clk_wiz_0/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y3 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]
set_property LOC BUFGCTRL_X0Y16 [get_cells clk_buf_BUFG_inst]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X1Y145 [get_cells DA2_clk_OBUF_inst]
set_property LOC IOB_X1Y88 [get_cells DA1_clk_OBUF_inst]
set_property LOC IOB_X1Y66 [get_cells AD_clk_OBUF_inst]

# Location of clock ports
set_property LOC IOB_X1Y76 [get_ports sys_clk]

# Clock net "u_clk_wiz_1/inst/clk_out3" driven by instance "u_clk_wiz_1/inst/clkout3_buf" located at site "BUFGCTRL_X0Y4"
#startgroup
create_pblock {CLKAG_u_clk_wiz_1/inst/clk_out3}
add_cells_to_pblock [get_pblocks  {CLKAG_u_clk_wiz_1/inst/clk_out3}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_clk_wiz_1/inst/clk_out3"}]]]
resize_pblock [get_pblocks {CLKAG_u_clk_wiz_1/inst/clk_out3}] -add {CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

